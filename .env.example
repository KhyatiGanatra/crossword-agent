TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Sweep and repair model (run without reasoning)
TOKEN_FACTORY_MODEL=moonshotai/Kimi-K3
# Stronger no-reasoning model for unverified entries; set to none to disable
TOKEN_FACTORY_STRONG_MODEL=deepseek-ai/DeepSeek-V4-Pro
# Bounded-reasoning model for the last unverified entries; set to none to disable
TOKEN_FACTORY_REASONING_MODEL=zai-org/GLM-5.3-Flash
# Reasoning model that audits clue fit after the fill; set to none to disable
TOKEN_FACTORY_AUDIT_MODEL=zai-org/GLM-5.3-Flash
TOKEN_FACTORY_REQUEST_TIMEOUT=180
CROSSWORD_RUN_LOG=eval-results/model-runs.jsonl
